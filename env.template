# --- Data ---
DATA_DIR=data
# Leave empty to auto-pick 12 channels (6 SMAP + 6 MSL). Or list them: P-1,S-1,E-1,...
CHANNELS=P-1,S-1,E-1,A-1,D-1,G-1,P-10,T-4,F-7,C-1
MAX_CHANNELS=12
BASE_RATE=10

# --- Gemini (flight director). Empty = rule-based diagnoses. ---
GEMINI_API_KEY=
# Pick a model AI Studio lists as free for your key.
GEMINI_MODEL=gemini-2.5-flash
# Stay under your free-tier requests per minute (check AI Studio).
GEMINI_RPM=4

# --- ElevenLabs (voice). Empty = captions only. ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Tiger Data. Empty = in-memory only. ---
# Example: postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=

# --- Autonomy timing (seconds) ---
VETO_SECONDS=30
REMIND_SECONDS=180
VERIFY_TIMEOUT=60
HEARTBEAT_SECONDS=300

# --- Detector sensitivity: raise either to cut false alarms ---
Z_THRESHOLD=4.0
CONSECUTIVE=3

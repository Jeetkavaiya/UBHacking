# --- Data ---
DATA_DIR=data
# Leave empty to auto-pick 12 channels (6 SMAP + 6 MSL). Or list them: P-1,S-1,E-1,...
CHANNELS=P-1,S-1,E-1,A-1,D-1,G-1,P-10,T-4,F-7,C-1
MAX_CHANNELS=12
BASE_RATE=10

# --- Simulated satellite SIM-1 (named parts, commands with real effects, known true causes) ---
SIM=on
# What streams at start: nasa | sim | both (switch live with POST /api/control/mode)
MODE=both

# --- Gemini (flight director). Empty = rule-based diagnoses. ---
GEMINI_API_KEY=
# Pick a model AI Studio lists as free for your key.
GEMINI_MODEL=gemini-2.5-flash
# Stay under your free-tier requests per minute (check AI Studio).
GEMINI_RPM=4
# Which incidents use Gemini (others get instant rule-based diagnoses). "all" = every incident.
GEMINI_SOURCES=synthetic,sample-replay,sim-scenario
# Max Gemini requests per day, counted across restarts (free tier is 20; each incident uses 2). 0 = no limit.
GEMINI_DAILY_LIMIT=18

# --- ElevenLabs (voice). Empty = captions only. ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Tiger Data. Empty = in-memory only. ---
# Example: postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=

# --- Autonomy timing (seconds) ---
VETO_SECONDS=30
REMIND_SECONDS=180
VERIFY_TIMEOUT=60
HEARTBEAT_SECONDS=300

# --- Detector sensitivity: raise either to cut false alarms ---
Z_THRESHOLD=4.0
CONSECUTIVE=3
